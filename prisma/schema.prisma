datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum StaffRole {
  OWNER
  STORE_MANAGER
  SUPERVISOR
  CASHIER
  BARISTA
}

enum OrderChannel {
  WALK_IN
  TAKEAWAY
  DELIVERY
  DINE_IN
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH_USD
  CASH_KHR
  DYNAMIC_QR
  CREDIT_CARD
}

enum UnitOfMeasure {
  GRAM
  ML
  UNIT
  PIECE
}

enum StockTransactionType {
  RESTOCK
  SOLD_ORDER
  WASTE_SPILLAGE
  AUDIT_ADJUSTMENT
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  PAY_IN
  PAY_OUT
  CASH_DROP
}

enum StationType {
  BARISTA
  KITCHEN
  BOTH
}

enum POStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

// -----------------------------------------------------------------------------
// Tenants & Stores (Multi-Store Support #4)
// -----------------------------------------------------------------------------

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  plan        String   @default("GROWTH")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stores      Store[]
  users       User[]
  categories  Category[]
  products    Product[]
  ingredients RawIngredient[]
  telegramConfig TelegramConfig?

  @@index([slug])
}

model Store {
  id               String   @id @default(uuid())
  tenantId         String
  name             String
  code             String   // e.g. "BKK1-STORE", "AIRPORT-KIOSK"
  address          String?
  phone            String?
  currency         String   @default("USD")
  khrRate          Float    @default(4000.0)
  taxRate          Float    @default(0.10)
  priceMultiplier  Float    @default(1.0) // Location price tiering (e.g. 1.15 for +15% at Airport)
  receiptHeader    String?  @default("Thank you for visiting!")
  receiptFooter    String?  @default("Wi-Fi: CafeGuest / Pass: Coffee2026")
  currentTicketSeq  Int      @default(1000)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles        UserStoreRole[]
  orders           Order[]
  shifts           CashShift[]
  stockTransactions StockTransaction[]
  ingredients      RawIngredient[]
  purchaseOrders   PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model TelegramConfig {
  id               String   @id @default(uuid())
  tenantId         String   @unique
  botToken         String?
  chatId           String?
  notifyLowStock   Boolean  @default(true)
  notifyZReport    Boolean  @default(true)
  notifySpillage   Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  email        String?  @unique
  pinHash      String   // bcrypt hashed 4-6 digit quick login PIN
  passwordHash String?  // Optional password for Owner/Manager web login
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeRoles   UserStoreRole[]
  cashShifts   CashShift[]
  ordersHandled Order[]
  stockAudits  StockTransaction[]

  @@index([tenantId])
}

model UserStoreRole {
  id        String    @id @default(uuid())
  userId    String
  storeId   String
  role      StaffRole @default(CASHIER)
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
}

// -----------------------------------------------------------------------------
// Catalog & Modifiers
// -----------------------------------------------------------------------------

model Category {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  icon        String   @default("Coffee")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Product {
  id             String      @id @default(uuid())
  tenantId       String
  categoryId     String
  sku            String      @unique
  name           String
  description    String?
  price          Float       // Base master price in USD
  costPrice      Float       @default(0.0) // Estimated BOM Cost Price
  customizable   Boolean     @default(true)
  station        StationType @default(BARISTA) // Multi-station KDS routing
  imageUrl       String?
  isActive       Boolean     @default(true)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category        @relation(fields: [categoryId], references: [id])
  modifierGroups ModifierGroup[]
  recipes        ProductRecipe[]
  orderItems     OrderItem[]

  @@index([tenantId])
  @@index([categoryId])
}

model ModifierGroup {
  id          String   @id @default(uuid())
  productId   String
  name        String   // "Size", "Sweetness", "Ice Level", "Milk Option"
  minSelect   Int      @default(1)
  maxSelect   Int      @default(1)
  isRequired  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  options     ModifierOption[]

  @@index([productId])
}

model ModifierOption {
  id                String   @id @default(uuid())
  modifierGroupId   String
  name              String   // "Regular", "Large", "Oat Milk", "50% Sweetness"
  priceDelta        Float    @default(0.0)
  isDefault         Boolean  @default(false)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  modifierGroup     ModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  recipes           ModifierRecipe[]
  orderItemModifiers OrderItemModifier[]

  @@index([modifierGroupId])
}

// -----------------------------------------------------------------------------
// Inventory, Bill of Materials (BOM) & Supplier POs
// -----------------------------------------------------------------------------

model RawIngredient {
  id               String        @id @default(uuid())
  tenantId         String
  storeId          String
  name             String        // "Espresso Coffee Beans", "Whole Fresh Milk"
  sku              String
  unit             UnitOfMeasure @default(GRAM)
  currentStock     Float         @default(0.0)
  reorderThreshold Float         @default(100.0)
  costPerUnit      Float         @default(0.0)
  supplierName     String?       @default("Artisan Roastery Ltd")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store            Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productRecipes   ProductRecipe[]
  modifierRecipes  ModifierRecipe[]
  transactions     StockTransaction[]
  poItems          PurchaseOrderItem[]

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([tenantId])
}

model ProductRecipe {
  id             String        @id @default(uuid())
  productId      String
  ingredientId   String
  quantity       Float         // Quantity required for 1 standard serving (e.g. 18g beans)
  unit           UnitOfMeasure @default(GRAM)
  createdAt      DateTime      @default(now())

  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient     RawIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@index([productId])
  @@index([ingredientId])
}

model ModifierRecipe {
  id               String        @id @default(uuid())
  modifierOptionId String
  ingredientId     String
  quantityDelta    Float
  unit             UnitOfMeasure @default(GRAM)
  isReplacement    Boolean       @default(false)
  createdAt        DateTime      @default(now())

  modifierOption   ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Cascade)
  ingredient       RawIngredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([modifierOptionId])
  @@index([ingredientId])
}

model StockTransaction {
  id             String               @id @default(uuid())
  storeId        String
  ingredientId   String
  type           StockTransactionType
  quantityChange Float
  remainingStock Float
  referenceId    String?
  notes          String?
  createdById    String?
  createdAt      DateTime             @default(now())

  store          Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ingredient     RawIngredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  createdBy      User?                @relation(fields: [createdById], references: [id])

  @@index([storeId])
  @@index([ingredientId])
  @@index([referenceId])
  @@index([createdAt])
}

model PurchaseOrder {
  id             String            @id @default(uuid())
  storeId        String
  poNumber       String            // e.g. "PO-2026-0042"
  supplierName   String
  status         POStatus          @default(DRAFT)
  totalCost      Float             @default(0.0)
  notes          String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  store          Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items          PurchaseOrderItem[]

  @@index([storeId])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  ingredientId    String
  quantity        Float
  unitCost        Float
  totalCost       Float

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredient      RawIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([ingredientId])
}

// -----------------------------------------------------------------------------
// Orders, Tickets & Kitchen Operations
// -----------------------------------------------------------------------------

model Order {
  id              String         @id @default(uuid())
  tenantId        String
  storeId         String
  shiftId         String?
  cashierId       String?
  ticketNumber    String         // e.g. "1154"
  invoiceNumber   String         // e.g. "INV-BKK1-STORE-1154"
  channel         OrderChannel   @default(WALK_IN)
  status          OrderStatus    @default(PENDING)
  paymentStatus   PaymentStatus  @default(UNPAID)
  
  subtotal        Float
  tax             Float
  discount        Float          @default(0.0)
  total           Float
  currency        String         @default("USD")
  khrRate         Float          @default(4000.0)
  
  tableNumber     String?
  customerName    String?
  notes           String?
  
  preparingAt     DateTime?
  readyAt         DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shift           CashShift?     @relation(fields: [shiftId], references: [id])
  cashier         User?          @relation(fields: [cashierId], references: [id])
  items           OrderItem[]
  payments        PaymentTransaction[]

  @@index([storeId, createdAt])
  @@index([storeId, status])
  @@index([shiftId])
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  productId      String
  productName    String
  quantity       Int      @default(1)
  unitPrice      Float
  totalPrice     Float
  notes          String?
  isBumped       Boolean  @default(false)
  createdAt      DateTime @default(now())

  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product             @relation(fields: [productId], references: [id])
  modifiers      OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemModifier {
  id               String   @id @default(uuid())
  orderItemId      String
  modifierOptionId String
  groupName        String
  optionName       String
  priceDelta       Float    @default(0.0)
  createdAt        DateTime @default(now())

  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOption   ModifierOption @relation(fields: [modifierOptionId], references: [id])

  @@index([orderItemId])
}

model PaymentTransaction {
  id              String        @id @default(uuid())
  orderId         String
  storeId         String
  shiftId         String?
  method          PaymentMethod @default(CASH_USD)
  amountUSD       Float
  amountKHR       Float
  changeGivenUSD  Float         @default(0.0)
  changeGivenKHR  Float         @default(0.0)
  transactionRef  String?
  qrPayload       String?
  isConfirmed     Boolean       @default(true)
  createdAt       DateTime      @default(now())

  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shift           CashShift?    @relation(fields: [shiftId], references: [id])

  @@index([orderId])
  @@index([shiftId])
  @@index([transactionRef])
}

// -----------------------------------------------------------------------------
// Cash Drawer & Shift Management
// -----------------------------------------------------------------------------

model CashShift {
  id                    String            @id @default(uuid())
  storeId               String
  cashierId             String
  openedAt              DateTime          @default(now())
  closedAt              DateTime?
  status                ShiftStatus       @default(OPEN)
  
  startingFloatUSD      Float             @default(0.0)
  startingFloatKHR      Float             @default(0.0)
  
  endingCashActualUSD   Float?
  endingCashActualKHR   Float?
  
  endingCashExpectedUSD Float?
  endingCashExpectedKHR Float?
  
  overShortUSD          Float?
  overShortKHR          Float?
  
  totalCashSalesUSD     Float             @default(0.0)
  totalCashSalesKHR     Float             @default(0.0)
  totalQRSalesUSD       Float             @default(0.0)
  totalCardSalesUSD     Float             @default(0.0)
  totalDiscountsUSD     Float             @default(0.0)
  totalRefundsUSD       Float             @default(0.0)
  orderCount            Int               @default(0)
  
  zReportJson           String?
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  store                 Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashier               User              @relation(fields: [cashierId], references: [id])
  orders                Order[]
  payments              PaymentTransaction[]
  cashMovements         CashMovement[]

  @@index([storeId, status])
  @@index([cashierId])
}

model CashMovement {
  id              String           @id @default(uuid())
  shiftId         String
  type            CashMovementType
  amountUSD       Float            @default(0.0)
  amountKHR       Float            @default(0.0)
  reason          String
  authorizedById  String?
  createdAt       DateTime         @default(now())

  shift           CashShift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
}
